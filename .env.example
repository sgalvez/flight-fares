# Persistence. Omit DATABASE_URL to run in ephemeral/demo mode.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Telegram. Both are required to send messages.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Amadeus production credentials and a hard monthly ceiling copied from the
# Amadeus workspace. A value of 0 disables all Amadeus calls.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
AMADEUS_MONTHLY_CAP=0
AMADEUS_CAP_SAFETY_PERCENT=80

# The comparable price includes one cabin bag. These estimates are used only
# for unverified discovery offers and never trigger an urgent alert.
LATAM_CABIN_BAG_ESTIMATE_CLP=20000
SKY_CABIN_BAG_ESTIMATE_CLP=20000
JETSMART_CABIN_BAG_ESTIMATE_CLP=20000

# JSON array of public, anonymous booking-page adapters. Keep selectors and URL
# templates outside the code because airline sites change frequently.
# Tokens: {origin}, {destination}, {date}, {adults}.
BROWSER_SOURCES_JSON=[]

# Optional JSON list of public promotion pages to monitor.
PROMOTION_URLS_JSON=[]

# Optional profile; never enter account, card or credential numbers.
BANK_PRODUCTS=
LATAM_PASS_TIER=LATAM
LATAM_PASS_CLUB=false

RADAR_TIMEZONE=America/Santiago
HORIZON_DAYS=60
BROWSER_CHECKS_PER_DAY=18
SCREENSHOT_DIR=screenshots
LOG_LEVEL=info

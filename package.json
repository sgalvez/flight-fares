{
  "name": "scl-iqq-flight-radar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "RUN_BROWSER_TESTS=true vitest run src/sources/browser.test.ts",
    "test:watch": "vitest",
    "radar": "node --disable-warning=ExperimentalWarning --enable-source-maps dist/cli.js",
    "db:migrate": "node --disable-warning=ExperimentalWarning --enable-source-maps dist/db/migrate.js"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "playwright": "^1.55.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
